# Copy this to .env (gitignored, never commit it) and fill in real values.
# docker compose reads .env automatically from this directory - see docker-compose.yml's
# web service `environment:` block.

# VAPID credentials for Web Push ("Notify on completion" search feature).
# Generate a keypair once with: npx --yes web-push generate-vapid-keys
# Reuse the same pair forever afterward - regenerating invalidates every existing subscription.
WEBPUSH_PUBLIC_KEY=
WEBPUSH_PRIVATE_KEY=
WEBPUSH_SUBJECT=mailto:you@example.com
